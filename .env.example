# ---- Casa Libre Buyer Portal — environment ----
# Copy to .env.local (dev) or set these in your host's env (prod). Do NOT commit real values.

# AiroBase (self-hosted Supabase) — buyer/test DB
AIROBASE_URL=https://<your-db>.db.airosofts.com
AIROBASE_SECRET_KEY=sb_secret_xxx          # server-only, bypasses RLS
AIROBASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backblaze B2 (property photos)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=casalibre
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_PUBLIC_HOST=https://f005.backblazeb2.com
B2_PUBLIC_READS=false                       # false = images served via /api/media proxy

# Absolute base URL for image links in DB (leave empty for same-origin, or set to prod URL)
APP_PUBLIC_URL=

# Secrets — SESSION_SECRET signs the login cookie; use a long random string in prod
SESSION_SECRET=change_in_prod
CRON_SECRET=change_in_prod

# FX fallback (guaraníes per 1 USD) if the live rate feed is down
PYG_PER_USD=7300

# Auth email (Resend). The `from` MUST use a domain verified at resend.com/domains,
# otherwise Resend only delivers to the account owner. Use your verified domain.
RESEND_API_KEY=re_xxx
RESEND_FROM=Casa Libre <notifications@yourdomain.com>

# Stripe — test keys shown; swap for live keys in production.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# PostHog product analytics (client-side capture). Public project key (phc_…).
# Leave unset to disable analytics entirely (all track() calls no-op).
# Ingest host is the "i" host: US = https://us.i.posthog.com, EU = https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
