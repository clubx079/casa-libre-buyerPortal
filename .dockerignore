# Keep the build context clean AND — critically — never let a local env file get
# baked into the image (that was the cause of the "stale country" bug). At runtime
# the app reads only the env Coolify injects into the container.
.git
.gitignore
node_modules
.next
# NEVER copy any env file into the image:
.env
.env.*
!.env.example
npm-debug.log*
yarn-error.log*
Dockerfile
.dockerignore
README.md
*.md
docs
.vscode
.idea
